# =============================================================================
# /etc/hosting-admin.env  —  HomePage Hosting 管理 API 环境变量（重构版）
# 权限必须 600：chmod 600 /etc/hosting-admin.env && chown root:root ...
# 由 systemd 的 EnvironmentFile=-/etc/hosting-admin.env 加载
# =============================================================================

# ---- 必填：管理令牌（openssl rand -hex 24 生成）-----------------------------
# ⚠️ 未设置时所有受保护接口一律 503 锁死（fail-closed），不再有默认口令
ADMIN_TOKEN=请替换为随机令牌

# ---- 路径 ------------------------------------------------------------------
HOSTING_BASE=/home/hosting
SITES_DIR=/home/hosting/sites/u
META_DIR=/home/hosting/meta              # 用户元数据 JSON（created_at/note/quota）
SETTINGS_PATH=/home/hosting/settings.json
BACKUP_DIR=/home/hosting/backup
LEGACY_DB=/home/hosting/hosting.db       # 旧版 SQLite；启动时自动迁移后不再使用

# ---- 对外 URL / 端口 --------------------------------------------------------
FRP_URL=http://your-frp-domain:36122
NGINX_PORT=9060

# ---- 监听（保持 127.0.0.1，切勿改成 0.0.0.0）--------------------------------
LISTEN_HOST=127.0.0.1
LISTEN_PORT=9070

# ---- 新用户默认额度 / 目录属主 ----------------------------------------------
QUOTA_MB=200
WEB_USER=www-data
WEB_GROUP=www-data
